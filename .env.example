# RidgeRiceTalk 服务端环境变量示例
#
# 用途：
#   1. 作为手动部署时的配置参考模板（复制为 .env 或 .env.production 后填入实际值）
#   2. 了解服务端支持的所有环境变量
#
# 注意：
#   - 生产环境部署推荐使用 `bash server/scripts/deploy-embedded.sh`（自包含，无需
#     手动安装 PostgreSQL / LiveKit / Netease API / FFmpeg）或
#     `bash server/scripts/deploy-baremetal.sh`（传统 bare-metal，使用 systemd + PostgreSQL）
#   - 密钥类变量（JWT_SECRET / CSRF_TOKEN_SECRET / ENCRYPTION_KEY / LIVEKIT_API_SECRET）留空时，
#     服务端首次启动会自动生成随机密钥并持久化到 storage/secrets.json
#   - 请勿将填入真实密钥的 .env 文件提交到版本控制

# ============================================================
# 环境配置
# ============================================================
RRT_ENV=production                  # production / development
RRT_LOG_LEVEL=info                  # debug / info / warn / error
RRT_DEPLOY_MODE=embedded            # baremetal / docker / embedded
RRT_PUBLIC_ADDRESS=http://YOUR_SERVER_IP:50100  # 对外访问地址（CORS 白名单基准）

# 端口
RRT_PORT=50100                      # API 主端口
RRT_ADMIN_PORT=50102                # 管理后台端口

# CORS 白名单（逗号分隔，自动放行 Voice/Admin/localhost）
RRT_CORS_ORIGINS=http://YOUR_SERVER_IP:50100,http://YOUR_SERVER_IP:50102,http://localhost:50100,http://localhost:50102

# ============================================================
# 数据库（PostgreSQL）
# ============================================================
RRT_DATABASE_URL=postgres://ridgericetalk:YOUR_PASSWORD@localhost:5432/ridgericetalk?sslmode=disable
RRT_DB_DRIVER=postgres              # postgres / sqlite
RRT_DB_PASSWORD=YOUR_PASSWORD       # PostgreSQL 应用用户密码
POSTGRES_PASSWORD=YOUR_PASSWORD     # 同上（部署脚本兼容字段）

# ============================================================
# 密钥（留空将自动生成并持久化到 storage/secrets.json）
# ============================================================
RRT_JWT_SECRET=
RRT_CSRF_TOKEN_SECRET=
RRT_ENCRYPTION_KEY=

# ============================================================
# 自包含依赖（开发/一键部署）
# ============================================================
RRT_EMBEDDED_DEPS=true              # true: 服务端自动管理 LiveKit、Netease API；false: 使用外部服务
RRT_THIRD_PARTY_DIR=./third_party   # 自动下载的二进制依赖目录
RRT_MODELS_DIR=./models             # 自动下载的模型资源目录

# ============================================================
# LiveKit（语音频道）
# ============================================================
RRT_LIVEKIT_API_KEY=
RRT_LIVEKIT_API_SECRET=
RRT_LIVEKIT_URL=ws://localhost:50101            # 内部地址（服务端连接用）
RRT_LIVEKIT_PUBLIC_URL=ws://YOUR_SERVER_IP:50101  # 公网地址（前端连接用）
RRT_LIVEKIT_AUTOSTART=true                      # 是否由服务端自动启动 LiveKit 进程

# ============================================================
# NeteaseCloudMusicApi（音乐机器人依赖）
# ============================================================
# embedded=true 时使用 services/netease-api/ 自动启动，无需修改
RRT_NETEASE_API_ENDPOINT=http://127.0.0.1:3300

# ============================================================
# FFmpeg（音乐机器人 / TTS）
# ============================================================
# embedded=true 且 PATH 中无 ffmpeg 时，服务端自动下载；
# 如需使用系统或自定义 FFmpeg，取消注释并填写实际路径
# RRT_FFMPEG_BINARY_PATH=/usr/bin/ffmpeg
# RRT_FFPROBE_BINARY_PATH=/usr/bin/ffprobe

# ============================================================
# 存储
# ============================================================
RRT_STORAGE_TYPE=local              # local / s3
RRT_LOCAL_DATA_PATH=/opt/ridgericetalk/server/storage  # 运行时数据目录

# ============================================================
# 用户与注册
# ============================================================
RRT_ALLOW_REGISTER=true             # 是否允许公开注册
RRT_MAX_USERS=1000                  # 最大用户数

# ============================================================
# Owner 初始化（首次启动自动创建，留空则使用 bootstrap token 流程）
# ============================================================
# RRT_OWNER_USERNAME=admin
# RRT_OWNER_PASSWORD=YOUR_STRONG_PASSWORD
# RRT_OWNER_EMAIL=admin@example.com
