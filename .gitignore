# Frontend build artifacts
# 注意：webhost/dist/ 是部署必需资源（服务端内嵌托管前端），
# 必须纳入版本控制，下载后可直接部署。
# 仅排除 server/webhost/dist/（开发时本地构建的副本，部署脚本会从 webhost/dist/ 复制）
server/webhost/dist/

# Web frontend (development artifacts)
node_modules/
web/*/node_modules/
web/*/dist/
web/*/test-results/
web/*/coverage/
web/*/*.log

# Web frontend test screenshots (large artifacts, can be regenerated)
web/tests/dogfood/screenshots/
web/tests/verification-shots/
web/voice/tests/browser-qa/screenshots/

# NeteaseCloudMusicApi (source in repo, node_modules excluded)
services/netease-api/node_modules/
services/netease-api/.env

# Music Bot Worker (Node.js LiveKit Agents Worker)
# 源码（src/）与配置（package.json/tsconfig.json/systemd/）纳入版本控制，
# 排除构建产物 dist/ 与打包文件 worker-src.zip
music-bot-worker/dist/
music-bot-worker/worker-src.zip

# Server-side web frontend deployment copy
# 注意：server/webhost/dist/ 是部署必需资源（服务端内嵌托管前端），
# 必须纳入版本控制。server/web/ 是运行时部署副本，不纳入版本控制。
server/web/

# Auto-downloaded third-party binaries and models
